DATABASE_URL=mysql://kimai:kimai@localhost?unix_socket={{ .DataDir }}/mysql.sock&dbname=kimai&charset=utf8mb4&serverVersion=10.5.16-MariaDB
DEFAULT_URI={{ .AppUrl }}
MAILER_FROM=kimai@{{ .Domain }}
MAILER_URL=null://null
APP_ENV=prod
APP_SECRET={{ .Secret }}
TRUSTED_PROXIES=127.0.0.1,localhost,{{ .AppDomain }}
TRUSTED_HOSTS=^localhost$|^{{ .AppDomain }}$
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$
